# Copy to .env and edit. Loaded automatically by rootutils at import time
# (see src/pretrain.py / src/finetune.py).

# ----------------------------------------------------------------------------
# Pre-training and downstream datasets.
# Expected layout:
#   $DATA_ROOT/
#     DATASET_UNIFIED_V1/                # SSL pre-training corpus (250k retina images)
#       images/<dataset>/...
#       labels/<dataset>/...
#     DATASET_EXTERNAL_EVAL_224/          # Pre-resized 224x224 downstream sets
#       MESSIDOR2/{images,labels_train.csv,labels_test.csv}
#       FIVES/...
#       IDRiD/...
#       PAPILA/...
#       REFUGE/...
#       RFMiD2/...
DATA_ROOT=/path/to/your/data

# ----------------------------------------------------------------------------
# Pre-trained baseline checkpoints (downloaded from upstream releases).
# See MODEL_ZOO.md for required filenames.
# Expected layout:
#   $CKPT_ROOT/
#     retmae/encoder_epoch_0000099.pth
#     retfound/RETFound_cfp_weights.pth
#     retfound/RETFound_dinov2_shanghai.pth
#     retfound/RETFound_mae_shanghai.pth
#     flair/flair_resnet.pth
#     keepfit/KeepFIT (flair+MM).pth
#     urfound/urfound_mm.pth
#     retclip/ret-clip.pt
#     unimedclip/unimed_clip_vit_b16.pt
#     vilref/ViLReF_ViT.pt
CKPT_ROOT=/path/to/your/checkpoints

# ----------------------------------------------------------------------------
# Where Hydra writes run outputs (logs, checkpoints, hparams).
OUTPUT_ROOT=${PWD}/outputs
